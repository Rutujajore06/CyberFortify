# CyberFortify Environment Configuration Example
# Copy this file to .env and adjust variables as needed

FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
HOST=127.0.0.1
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-strong-random-secret-key

# Persistent SQLite database path (mount a persistent disk in production, e.g. /var/data/cyberfortify.db)
# DATABASE_PATH=/var/data/cyberfortify.db

# Authentication & RBAC (Automatically enforced on public/production deployments)
REQUIRE_AUTH=false
LOCAL_DEMO_MODE=true
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
STRICT_PRODUCTION_CONFIG=false

# Optional: Provision an initial Admin user via environment variables (never commit real passwords)
# CYBERFORTIFY_ADMIN_USERNAME=
# CYBERFORTIFY_ADMIN_EMAIL=
# CYBERFORTIFY_ADMIN_PASSWORD=
# Optional: One-time bootstrap token required for /api/auth/setup-admin on public deployments
# CYBERFORTIFY_BOOTSTRAP_TOKEN=
